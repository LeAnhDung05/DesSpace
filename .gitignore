# Secrets and environment config
.env
.env.*
!.env.example
wp-config.php
wordpress/wp-config.php
auth.json

# WordPress core and runtime
wordpress/wp-admin/
wordpress/wp-includes/
wordpress/wp-content/cache/
wordpress/wp-content/upgrade/
wordpress/wp-content/backups/
wordpress/wp-content/uploads/*
!wordpress/wp-content/uploads/3d/
!wordpress/wp-content/uploads/3d/**
!wordpress/wp-content/uploads/despace-catalog/
wordpress/wp-content/uploads/despace-catalog/*
!wordpress/wp-content/uploads/despace-catalog/images/
!wordpress/wp-content/uploads/despace-catalog/images/**
!wordpress/wp-content/uploads/products-real/
!wordpress/wp-content/uploads/products-real/**
!wordpress/wp-content/uploads/journal/
!wordpress/wp-content/uploads/journal/**
!wordpress/wp-content/uploads/hero.jpg
!wordpress/wp-content/uploads/logo.png
!wordpress/wp-content/uploads/woocommerce-placeholder*.webp
wordpress/wp-content/languages/
wordpress/wp-content/debug.log

# WordPress plugins and themes isolation
wordpress/wp-content/plugins/*
!wordpress/wp-content/plugins/despace-core/
wordpress/wp-content/themes/*
!wordpress/wp-content/themes/despace-child/

# Local databases and backups
*.sql
*.sql.gz
*.sqlite
*.db
*.dump
*.zip
*.tar.gz
!database/despace_seed_data.sql
!database/despace_seed_data.sql.gz

# Whitelist project database scripts & docs (never accidental raw dumps)
!database/
!database/*.sh
!database/*.bat
!database/*.md
!database/*.csv
database/backup_*


# Dependencies and IDE / OS files
/vendor/
node_modules/
coverage/
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
__pycache__/
*.pyc
desktop_app/output/*
!desktop_app/output/.gitkeep
desktop_app/temp/
desktop_app/settings.json
wordpress/wp-content/jetpack-waf/
scratch/
DesSpace/
.mimosa/
