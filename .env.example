# Chỉ dùng cho môi trường phát triển cục bộ — KHÔNG dùng mật khẩu mẫu trên Production.
DESPACE_PORT=8090
DESPACE_SITE_URL=http://localhost:8090

MYSQL_DATABASE=despace
MYSQL_USER=despace
MYSQL_PASSWORD=change-me-local-db-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password

WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me-strong-admin-password
WORDPRESS_ADMIN_EMAIL=admin@despace.test

# Desktop 3D Studio Sync API Key (tối thiểu 32 ký tự ngẫu nhiên, khớp với wp_options.despace_desktop_sync_key)
DESPACE_DESKTOP_KEY=
DESPACE_LOCAL_PORT=58300

# Local Tunnel (chỉ bật khi test AR qua Cloudflare/Ngrok trên môi trường local)
DESPACE_ENABLE_DYNAMIC_TUNNEL=0
DESPACE_TUNNEL_HOST=

# Local Mailpit SMTP (chỉ áp dụng cho môi trường local/staging)
DESPACE_MAILPIT_HOST=despace-mailpit
DESPACE_MAILPIT_PORT=1025

# Optional AI API Keys (để trống nếu dùng chế độ Parametric PBR mặc định)
GEMINI_API_KEY=
FAL_KEY=
TRIPO_API_KEY=
