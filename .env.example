# Local-only credentials. Change these before exposing the site on a network.
WP_PORT=8080
DB_NAME=despace
DB_USER=despace
DB_PASSWORD=despace_local_only
DB_ROOT_PASSWORD=root_local_only

# Local WordPress setup. Change WP_ADMIN_PASSWORD before running bootstrap.
WP_URL=http://localhost:8080
WP_TITLE=DeSpace Staging MVP
WP_ADMIN_USER=despaceadmin
WP_ADMIN_PASSWORD=Change-this-local-password-123!
WP_ADMIN_EMAIL=admin@example.test
